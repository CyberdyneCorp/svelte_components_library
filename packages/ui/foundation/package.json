{
  "name": "@cyberdynecorp/svelte-ui-foundation",
  "version": "0.4.0",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./styles": "./src/lib/styles/index.css",
    "./themes/calm.css": "./src/lib/themes/calm.css",
    "./tokens": {
      "types": "./src/lib/tokens/tokens.ts",
      "default": "./src/lib/tokens/tokens.ts"
    },
    "./theme": {
      "types": "./src/lib/theme/index.ts",
      "default": "./src/lib/theme/index.ts"
    }
  },
  "files": [
    "src/lib/**/*.css",
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.ts"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
